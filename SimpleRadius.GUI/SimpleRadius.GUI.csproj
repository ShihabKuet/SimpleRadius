<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SimpleRadius</AssemblyName>
    <RootNamespace>SimpleRadius.GUI</RootNamespace>
    <StartupObject>SimpleRadius.GUI.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleRadius.Core\SimpleRadius.Core.csproj" />
  </ItemGroup>

  <!-- No external NuGet packages required -->

</Project>
