<Window x:Class="SimpleRadius.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Radius — RADIUS Server"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource SidebarTextBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="14,8"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F2030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActiveStyle" TargetType="Button">
            <Setter Property="Background"                 Value="#162336"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="14,8"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="FontWeight"                 Value="Medium"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AccentBlueBrush}"
                                BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR                                                           -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <DockPanel>

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="7"
                                Background="{StaticResource AccentBlueBrush}" Margin="0,0,10,0">
                            <TextBlock Text="SR" FontSize="13" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Simple Radius" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="v1.0 — Phase 1" FontSize="10" Foreground="#4A6080"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status chip -->
                    <Border x:Name="StatusChip" CornerRadius="5" Margin="0,10,0,0" Padding="8,5">
                        <Border.Background>
                            <SolidColorBrush x:Name="StatusChipBg" Color="#260D0D"/>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="StatusDotColor" Color="#EF4444"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="Server Stopped" FontSize="11" FontWeight="Medium">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="StatusTextColor" Color="#EF4444"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,12">
                    <Rectangle Height="1" Fill="#1E2D3D" Margin="0,0,0,8"/>
                    <TextBlock Text="Auth:  UDP 1812" FontSize="10" Foreground="#3D5570"/>
                    <TextBlock Text="Acct:  UDP 1813" FontSize="10" Foreground="#3D5570" Margin="0,2,0,0"/>
                    <TextBlock x:Name="UptimeText" Text="Uptime: —" FontSize="10"
                               Foreground="#3D5570" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Nav -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="MONITOR" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#2D4055" Margin="14,10,0,4"/>
                        <Button x:Name="NavDashboard" Tag="Dashboard" Click="NavButton_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x229E;" Width="20" FontSize="13"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLogs" Tag="Logs" Click="NavButton_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25B6;" Width="20" FontSize="11"/>
                                <TextBlock Text="Live Logs"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="CONFIGURE" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#2D4055" Margin="14,12,0,4"/>
                        <Button x:Name="NavUsers" Tag="Users" Click="NavButton_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25C9;" Width="20" FontSize="13"/>
                                <TextBlock Text="Users"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavNas" Tag="NAS" Click="NavButton_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x229F;" Width="20" FontSize="13"/>
                                <TextBlock Text="NAS / Clients"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SYSTEM" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#2D4055" Margin="14,12,0,4"/>
                        <Button x:Name="NavSettings" Tag="Settings" Click="NavButton_Click"
                                Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2699;" Width="20" FontSize="13"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                                      -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="1">

            <!-- Top bar -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PageSubtitle" Text="Server overview and live statistics"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnToggleServer" Grid.Column="1" Content="Start Server"
                            Style="{StaticResource BtnPrimary}" Width="115"
                            Click="BtnToggleServer_Click"/>
                </Grid>
            </Border>

            <!-- Pages -->
            <Grid Background="{StaticResource ContentBgBrush}">

                <!-- DASHBOARD -->
                <ScrollViewer x:Name="PageDashboard" Padding="18,14" Visibility="Visible"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="AUTH ACCEPTED" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="StatAccepts" Text="0" FontSize="26"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,6,0,2"/>
                                    <TextBlock Text="total accepted" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="AUTH REJECTED" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="StatRejects" Text="0" FontSize="26"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource AccentRedBrush}" Margin="0,6,0,2"/>
                                    <TextBlock Text="total rejected" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ACCOUNTING PKT" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="StatAccounting" Text="0" FontSize="26"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,6,0,2"/>
                                    <TextBlock Text="accounting records" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="SERVER UPTIME" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="StatUptime" Text="&#x2014;" FontSize="26"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                                    <TextBlock Text="since last start" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Recent Authentication Events" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="DashboardEventGrid" Height="240" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time"     Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="75"/>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}"   Width="*"/>
                                        <DataGridTextColumn Header="NAS IP"   Binding="{Binding NasIp}"      Width="120"/>
                                        <DataGridTextColumn Header="Method"   Binding="{Binding Method}"     Width="80"/>
                                        <DataGridTextColumn Header="Result"   Binding="{Binding ResultText}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- LIVE LOGS -->
                <Grid x:Name="PageLogs" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="18,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Clear Log" Style="{StaticResource BtnSecondary}"
                                    Click="BtnClearLog_Click" Margin="0,0,10,0"/>
                            <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True"
                                      VerticalAlignment="Center" FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="LogListBox" Grid.Row="1"
                             Background="#0D1117" Foreground="#C9D1D9"
                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                             BorderThickness="0" Padding="12,8"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- USERS -->
                <ScrollViewer x:Name="PageUsers" Padding="18,14" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Add New User" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtNewUsername" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="PwdNewPassword" Margin="0,4,0,0"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1" Padding="8,6" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="GROUP" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbUserGroup" Margin="0,4,0,0" SelectedIndex="0">
                                            <ComboBoxItem Content="default"/>
                                            <ComboBoxItem Content="admins"/>
                                            <ComboBoxItem Content="guests"/>
                                            <ComboBoxItem Content="iot"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="VLAN ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtNewVlan" Text="1" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Add User"
                                            Style="{StaticResource BtnPrimary}"
                                            VerticalAlignment="Bottom" Click="BtnAddUser_Click"/>
                                </Grid>
                                <TextBlock x:Name="UserFormError" Text="" FontSize="11"
                                           Foreground="{StaticResource AccentRedBrush}"
                                           Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="User Database" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="UsersGrid" Height="300" IsReadOnly="True"
                                          SelectionChanged="UsersGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username"    Binding="{Binding Username}"    Width="*"/>
                                        <DataGridTextColumn Header="Group"       Binding="{Binding Group}"       Width="100"/>
                                        <DataGridTextColumn Header="VLAN"        Binding="{Binding VlanId}"      Width="60"/>
                                        <DataGridTextColumn Header="Enabled"     Binding="{Binding IsEnabled}"   Width="70"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Delete Selected" Style="{StaticResource BtnDanger}"
                                            Click="BtnDeleteUser_Click"/>
                                    <Button Content="Toggle Enabled" Style="{StaticResource BtnSecondary}"
                                            Margin="8,0,0,0" Click="BtnToggleUser_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- NAS -->
                <ScrollViewer x:Name="PageNas" Padding="18,14" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Add NAS Client" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="FRIENDLY NAME" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtNasName" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="IP ADDRESS / CIDR" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtNasIp" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="SHARED SECRET" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="PwdNasSecret" Margin="0,4,0,0"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1" Padding="8,6" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="VENDOR" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbNasVendor" Margin="0,4,0,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Generic"/>
                                            <ComboBoxItem Content="Cisco"/>
                                            <ComboBoxItem Content="Ubiquiti"/>
                                            <ComboBoxItem Content="Mikrotik"/>
                                            <ComboBoxItem Content="Fortinet"/>
                                            <ComboBoxItem Content="HP / Aruba"/>
                                            <ComboBoxItem Content="Juniper"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Add NAS"
                                            Style="{StaticResource BtnPrimary}"
                                            VerticalAlignment="Bottom" Click="BtnAddNas_Click"/>
                                </Grid>
                                <TextBlock x:Name="NasFormError" Text="" FontSize="11"
                                           Foreground="{StaticResource AccentRedBrush}"
                                           Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Registered NAS Clients" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="NasGrid" Height="280" IsReadOnly="True"
                                          SelectionChanged="NasGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name"        Binding="{Binding Name}"        Width="*"/>
                                        <DataGridTextColumn Header="IP / CIDR"   Binding="{Binding IpAddress}"   Width="140"/>
                                        <DataGridTextColumn Header="Vendor"      Binding="{Binding Vendor}"      Width="100"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Delete Selected" Style="{StaticResource BtnDanger}"
                                        Margin="0,10,0,0" Click="BtnDeleteNas_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="PageSettings" Padding="18,14" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Server Configuration" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="AUTH PORT (UDP)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtAuthPort" Text="1812" Margin="0,4,0,12"/>
                                        <TextBlock Text="BIND ADDRESS" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtBindAddr" Text="0.0.0.0" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ACCOUNTING PORT (UDP)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtAcctPort" Text="1813" Margin="0,4,0,12"/>
                                        <TextBlock Text="DATA DIRECTORY" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtDataDir" Text="data" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,14,0,0" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Restart the server after changing any setting."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="About Simple Radius — Phase 1" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                           Foreground="{StaticResource TextSecondaryBrush}">
Phase 1 supports: PAP authentication, local JSON user store, VLAN assignment via Tunnel attributes, NAS client registry with IP/CIDR matching, RFC 2866 accounting responses, and live log streaming.

Coming in Phase 2: CHAP, MSCHAPv2, PEAP/MSCHAPv2, EAP-TLS, bcrypt password hashing, Windows Service installer, and LDAP/Active Directory backend.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
